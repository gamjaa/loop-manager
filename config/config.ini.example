; 실제 config는 커밋하지 않는다. 선택 Provider의 모델과 역할을 명시한다.
[loop]
; Planner·Worker·Reviewer 공통 AI 한도. 프로젝트 Worker 1, 전역 Verify 1은 고정이다.
max_workers = 3
verify_timeout_seconds = 600
; 이 저장소 자체 Verify의 내부 병렬도. 등록 프로젝트에는 강제하지 않는다.
verify_parallelism = auto

[telegram]
; 둘 다 비우면 미사용. 하나만 입력하면 설정 오류다.
token =
chat_id =

[codex]
fast_mode = false

[codex.models]
strong = gpt-6.1-sol
balanced = gpt-6.1-terra

[codex.roles]
planner = strong,high
reviewer = strong,high

[codex.worker]
; complexity low=1, medium=3, high=5 + critical risk일 때만 1.
level1 = balanced,low
level2 = balanced,medium
level3 = balanced,high
level4 = strong,medium
level5 = strong,high
level6 = strong,xhigh

[claude]
fast_mode = false

[claude.models]
strong = claude-opus-5-5
balanced = claude-sonnet-5-5
review = claude-opus-5

[claude.roles]
planner = strong,medium
reviewer = review,high

[claude.worker]
level1 = balanced,low
level2 = balanced,medium
level3 = balanced,medium
level4 = balanced,high
level5 = strong,medium
level6 = strong,high
