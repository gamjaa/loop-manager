; config.ini로 복사한 뒤 현재 CLI가 지원하는 정확한 값을 입력한다.
; config.ini는 Telegram token을 포함하므로 Git에 커밋하지 않는다.

[loop]
max_workers = 3
; 첫 시작 기준 또는 마지막 성공한 파일별 평가 이후 이 수만큼 ExecPlan Merge가 확인되면 평가한다.
refactoring_review_interval = 20
; 전체 verify의 최대 실행 시간(초). 필요한 검증이 정상 진행 중이면 값을 늘린다.
verify_timeout_seconds = 600
; auto는 실제 CPU·메모리 부하로 배정한다. 양의 정수는 verify별 상한이며 1은 직렬이다.
verify_parallelism = auto

[telegram]
; token과 chat_id가 모두 비어 있으면 알림을 사용하지 않는다.
; 둘 중 하나만 입력하면 설정 오류다.
token =
chat_id =

[codex.models]
frontier = gpt-6-astra
strong = gpt-5.6-sol
balanced = gpt-5.6-terra
fast = gpt-5.6-luna

[codex.roles]
planner = strong,xhigh
; 읽기 전용 점검 Planner. 생략하면 planner 값을 사용한다.
planner_check = strong,xhigh
; 유지보수 평가·관계 검토·계획에 사용할 Model alias,Effort. 기존 설정에서 생략하면 planner를 사용한다.
maintenance_planner = strong,xhigh
reviewer = strong,high

[codex.worker]
level1 = fast,medium
level2 = balanced,low
level3 = balanced,medium
level4 = balanced,high
level5 = strong,medium
level6 = strong,high
level7 = strong,xhigh
level8 = frontier,low

[claude.models]
strong = claude-opus-5
balanced = claude-sonnet-5
fast = claude-haiku-4-5-20251001

[claude.roles]
planner = strong,high
; 생략하면 planner 값을 사용한다.
planner_check = strong,high
maintenance_planner = strong,high
reviewer = strong,high

[claude.worker]
level1 = fast,medium
level2 = balanced,low
level3 = balanced,medium
level4 = balanced,high
level5 = strong,medium
level6 = strong,high
level7 = strong,xhigh
level8 = strong,max
