; 지원 CLI 환경에서는 config.ini로 복사해 모델 설정 보완 없이 사용한다.
; 예시는 누락된 운영 설정의 fallback이 아니다.
; 최초 level = complexity(low=1, medium=3, high=5) + critical risk만 1.
; level 7·8은 Review 승격으로만 도달하며 모든 level을 명시해야 한다.
; config.ini는 Telegram token을 포함하므로 Git에 커밋하지 않는다.

[loop]
max_workers = 3
; 첫 시작 기준 또는 마지막 성공한 파일별 평가 이후 이 수만큼 ExecPlan Merge가 확인되면 평가한다.
refactoring_review_interval = 20
; 전체 verify의 최대 실행 시간(초). 필요한 검증이 정상 진행 중이면 값을 늘린다.
verify_timeout_seconds = 600
; auto는 실제 CPU·메모리 부하로 배정한다. 양의 정수는 verify별 상한이며 1은 직렬이다.
verify_parallelism = auto

[telegram]
; token과 chat_id가 모두 비어 있으면 알림을 사용하지 않는다.
; 둘 중 하나만 입력하면 설정 오류다.
token =
chat_id =

[codex]
; true: Fast 요청, false: Fast 끄기, 공란·생략: CLI 기본 설정 상속.
; Fast 사용에는 추가 비용 또는 구독 사용량 증가가 발생할 수 있다.
fast_mode =

[codex.models]
frontier = gpt-6-astra
strong = gpt-6.1-sol
balanced = gpt-5.6-terra
fast = gpt-6-luna

[codex.roles]
planner = strong,high
; 읽기 전용 점검 Planner.
planner_check = fast,high
; 유지보수 평가·관계 검토·계획에 사용할 Model alias,Effort.
maintenance_planner = strong,high
reviewer = strong,high

[codex.worker]
level1 = fast,low
level2 = fast,medium
level3 = balanced,medium
level4 = balanced,high
level5 = strong,medium
level6 = strong,high
level7 = strong,xhigh
; 마지막 단계도 Sol 6.1 xhigh를 사용한다.
level8 = strong,xhigh

[claude]
; 동일하게 on/off 또는 CLI 기본 설정 상속을 선택한다.
fast_mode =

[claude.models]
; Opus 5.5: Claude Code >= 2.1.280, Sonnet 5.5: >= 2.1.284.
; 두 모델을 함께 쓰는 이 예시는 >= 2.1.284가 필요하다.
strong = claude-opus-5-5
balanced = claude-sonnet-5-5
review = claude-opus-5
fast = claude-haiku-4-5-20251001

[claude.roles]
planner = strong,medium
; 읽기 전용 점검 Planner도 직접 지정한다.
planner_check = balanced,medium
maintenance_planner = strong,medium
reviewer = review,high

[claude.worker]
level1 = balanced,low
level2 = balanced,medium
level3 = balanced,medium
level4 = balanced,high
level5 = strong,medium
level6 = strong,high
level7 = strong,xhigh
level8 = strong,max
